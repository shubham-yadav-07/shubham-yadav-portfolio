# OPTIONAL - contact form endpoint (e.g. Formspree: https://formspree.io/f/xxxxxxxx).
# Leave empty to use the built-in mailto fallback (opens the visitor's email app).
# This is a PUBLIC endpoint URL, not a secret. Never put private API keys in VITE_ variables.
VITE_FORM_ENDPOINT=

# OPTIONAL - your deployed site URL (used only for SEO tags at build time, see README)
VITE_SITE_URL=
